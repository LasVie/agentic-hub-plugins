        },
        "tld": {
          "type": "string",
          "pattern": "^\\.?[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
          "maxLength": 64,
          "description": "不带点号的单级 ASCII 后缀，例如 com；不支持 co.uk 或中文域名。"
        }
      },
      "required": [
        "name",
        "tld"
      ],
      "additionalProperties": false
    }
  },
  "check_availability_batch": {
    "class": "AvailabilityBatchTool",
    "description_zh": "检查同一名称的 1–20 个后缀；cachedOnly=true 只读已有证据，未知不等于被注册。",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
          "maxLength": 63,
          "description": "一个 ASCII 名称标签，不含点号或后缀；会发送给公开服务。"
        },
        "tlds": {
          "type": "string",
          "maxLength": 1299,
          "description": "逗号分隔的 1–20 个单级后缀，例如 com,dev。"
        },
        "cachedOnly": {
          "type": "boolean",
          "default": false,
          "description": "true 只读取已有可注册性证据；缓存缺失属于未知。"
        }
      },
      "required": [
        "name",
        "tlds"
      ],
      "additionalProperties": false
    }
  },
  "open_name_finder": {
    "class": "NameFinderTool",
    "description_zh": "取得命名表单工作流；不支持内嵌表单时使用返回的网页入口，不进行模型推理或域名检查。",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "get_price_history": {
    "class": "PriceHistoryTool",
    "description_zh": "读取指定后缀的已保存价格历史；历史报价不是当前价格承诺。",
    "input_schema": {
      "type": "object",
      "properties": {
        "tld": {
          "type": "string",
          "pattern": "^\\.?[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
          "maxLength": 64,
          "description": "不带点号的单级 ASCII 后缀，例如 com；不支持 co.uk 或中文域名。"
        },
        "registrar": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9-]+$",
          "description": "单个已连接注册商 ID；与 registrars 互斥。"
        },
        "price": {
          "type": "string",
          "enum": [
            "renewal",
            "registration"
          ],
          "default": "renewal",
          "description": "历史价格指标；保留其时间范围和来源限定。"
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "markdown"
          ],
          "default": "json",
          "description": "返回格式；保留 JSON 原始证据，可另取 CSV 或 Markdown。"
        }
      },
      "required": [
        "tld"
      ],
      "additionalProperties": false
    }
  },
  "compare_domain_names": {
    "class": "CompareNamesTool",
    "description_zh": "对 1–10 个完整名称按续费排名，复用已有检查证据，不触发新的注册商检查。",
    "input_schema": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "string",
          "maxLength": 1279,
          "description": "逗号分隔的 1–10 个不重复完整 ASCII 域名，例如 example.com,example.org。"
        },
        "maxRenewalCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000,
          "description": "年度续费预算，整数美元分；15 美元写为 1500。"
        }
      },
      "required": [
        "domains"
      ],
      "additionalProperties": false
