    "input_schema": {
      "type": "object",
      "properties": {
        "tld": {
          "type": "string",
          "pattern": "^\\.?[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
          "maxLength": 64,
          "description": "不带点号的单级 ASCII 后缀，例如 com；不支持 co.uk 或中文域名。"
        },
        "registrar": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9-]+$",
