  "get_naming_guidance": {
    "class": "NamingGuidanceTool",
    "description_zh": "读取命名研究规则；保持项目背景在会话中，仅发送必要的查询参数。",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "check_availability": {
    "class": "AvailabilityTool",
    "description_zh": "按用户命名研究请求检查一个公开名称；会发送名称给服务及检查提供方，未知不等于被注册。",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
          "maxLength": 63,
          "description": "一个 ASCII 名称标签，不含点号或后缀；会发送给公开服务。"
        },
        "tld": {
          "type": "string",
          "pattern": "^\\.?[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
          "maxLength": 64,
          "description": "不带点号的单级 ASCII 后缀，例如 com；不支持 co.uk 或中文域名。"
        },
        "registrar": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9-]+$",
          "description": "单个已连接注册商 ID；与 registrars 互斥。"
        },
        "fresh": {
          "type": "boolean",
          "default": false,
          "description": "仅用户明确要求重新检查时设为 true；不自动刷新或重试。"
        }
      },
      "required": [
        "name",
        "tld"
      ],
      "additionalProperties": false
    }
  },
  "get_domain_popularity": {
    "class": "PopularityTool",
    "description_zh": "可选 DNS 热度查询；数据有独立 CC BY-NC 4.0 条款，商业复用需许可；不是 SEO 或可注册性判断。",
