{
  "search_prices": {
    "class": "SearchPricesTool",
    "description_zh": "按年度续费、预算、后缀和注册商筛选报价；价格以美元分为单位，不检查名称可注册性。",
    "input_schema": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "maxLength": 200,
          "default": "",
          "description": "后缀搜索，例如 .com,.org,.dev；仅比较价格时不发送项目背景。"
        },
        "registrar": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9-]+$",
          "description": "单个已连接注册商 ID；与 registrars 互斥。"
        },
        "registrars": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[a-z0-9-]+(?:,[a-z0-9-]+)*$",
          "description": "逗号分隔的注册商 ID；与 registrar 互斥。"
        },
        "favorites": {
          "type": "string",
          "maxLength": 81,
          "pattern": "^[a-z0-9-]+(?:,[a-z0-9-]+)?$",
          "description": "至多两个逗号分隔的注册商比较列，不保存偏好。"
        },
        "sort": {
          "type": "string",
          "enum": [
            "renewal",
            "registration",
            "total"
          ],
          "default": "renewal",
          "description": "比较指标；续费优先选择 renewal。"
        },
        "orderBy": {
          "type": "string",
          "enum": [
            "price",
            "extension"
          ],
          "default": "price",
          "description": "显示排序，不改变最低报价的选择规则。"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc",
          "description": "显示排序方向。"
        },
        "years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "新注册费用估算年数，1–10 的整数。"
        },
        "maxRenewalCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000,
          "description": "年度续费预算，整数美元分；15 美元写为 1500。"
        },
        "hideCountryCodes": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏国家或地区后缀。"
        },
        "hideJumps": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏续费跳涨报价。"
        },
        "view": {
          "type": "string",
          "enum": [
            "best",
            "all"
          ],
          "default": "best",
          "description": "best 每后缀最低已覆盖报价；all 显示各注册商报价。"
        },
        "includeStale": {
          "type": "boolean",
          "default": false,
          "description": "是否包含旧报价；搜索时须配合 view=all，保留过期标记。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50,
          "description": "本页条数，1–200；先使用小页，不扫描整个目录。"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0,
          "description": "分页偏移；只读取本次请求所需的页。"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
          "maxLength": 63,
          "description": "一个 ASCII 名称标签，不含点号或后缀；会发送给公开服务。"
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "markdown"
          ],
          "default": "json",
          "description": "返回格式；保留 JSON 原始证据，可另取 CSV 或 Markdown。"
        }
      },
      "additionalProperties": false
    }
  },
  "get_tld_prices": {
    "class": "TldPricesTool",
    "description_zh": "比较指定单级后缀的注册商报价；保留样本、税费、币种换算和来源日期。",
