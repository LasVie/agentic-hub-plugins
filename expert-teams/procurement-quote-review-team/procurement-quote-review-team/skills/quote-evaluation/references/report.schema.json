{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "采购报价比选成员记录 v2",
  "description": "结构契约；实际运行仍逐项验证角色、输入摘要、完整覆盖、数值边界及来源原文。notes不替代真实阻断问题。旧报告须保留并重新评审，不能无依据自动迁移。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "role",
        "case_sha256",
        "notes",
        "issues",
        "assessments"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "role": {
          "const": "technical"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "assessments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "role",
        "case_sha256",
        "notes",
        "issues",
        "totals"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "role": {
          "const": "commercial"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "totals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/total"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "role",
        "case_sha256",
        "notes",
        "issues",
        "assessments",
        "totals"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "role": {
          "const": "verifier"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "assessments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "totals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/total"
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "line",
        "quote"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offer_id",
        "criterion_id",
        "status",
        "score",
        "evidence",
        "rationale"
      ],
      "properties": {
        "offer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "criterion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "score": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        }
      }
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offer_id",
        "total"
      ],
      "properties": {
        "offer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "total": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        }
      }
    },
    "issue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "category",
            "message"
          ],
          "properties": {
            "scope": {
              "const": "global"
            },
            "category": {
              "enum": [
                "eligibility",
                "evaluation"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "category",
            "message",
            "offer_id"
          ],
          "properties": {
            "scope": {
              "const": "offer"
            },
            "category": {
              "enum": [
                "eligibility",
                "evaluation"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "offer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
