{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robot-route-review-team:contracts:1",
  "title": "多机器人路径规划复核案例与报告格式",
  "description": "还需运行包内程序检查跨字段坐标、身份唯一、摘要和路径语义。",
  "$defs": {
    "case": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "const": "grid-4-wait-stay-v1"
        },
        "grid": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 2,
              "maximum": 12
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "maximum": 12
            },
            "obstacles": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 144,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "width",
            "height",
            "obstacles"
          ],
          "additionalProperties": false
        },
        "robots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,23}$"
              },
              "start": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "goal": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "id",
              "start",
              "goal"
            ],
            "additionalProperties": false
          }
        },
        "horizon": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "limits": {
          "type": "object",
          "properties": {
            "high_level_nodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "low_level_nodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "title",
        "model",
        "grid",
        "robots",
        "horizon"
      ],
      "additionalProperties": false
    },
    "map_report": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "version": {
          "const": "1.0.0"
        },
        "role": {
          "const": "map-analyst"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "const": "grid-4-wait-stay-v1"
        },
        "notes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "status": {
          "const": "inspected"
        },
        "case": {
          "$ref": "#/$defs/case"
        }
      },
      "required": [
        "schema_version",
        "version",
        "role",
        "case_sha256",
        "model",
        "notes",
        "issues",
        "status",
        "case"
      ],
      "additionalProperties": false
    },
    "model_report": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "version": {
          "const": "1.0.0"
        },
        "role": {
          "const": "verifier-model"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "const": "grid-4-wait-stay-v1"
        },
        "notes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "status": {
          "const": "model_reviewed"
        },
        "horizon": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "robot_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "version",
        "role",
        "case_sha256",
        "model",
        "notes",
        "issues",
        "status",
        "horizon",
        "robot_ids"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "version": {
          "const": "1.0.0"
        },
        "role": {
          "const": "planner"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "const": "grid-4-wait-stay-v1"
        },
        "notes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "horizon": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "algorithm": {
          "const": "bounded-cbs-v1"
        },
        "map_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "found",
            "infeasible_within_horizon",
            "search_limit"
          ]
        },
        "paths": {
          "type": "object",
          "maxProperties": 4,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 41,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "metrics": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "sum_of_costs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 160
                },
                "makespan": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 40
                }
              },
              "required": [
                "sum_of_costs",
                "makespan"
              ],
              "additionalProperties": false
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "search": {
          "type": "object",
          "properties": {
            "high_level_expanded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "low_level_expanded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "limits": {
              "type": "object",
              "properties": {
                "high_level_nodes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "low_level_nodes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "complete": {
              "type": "boolean"
            }
          },
          "required": [
            "high_level_expanded",
            "low_level_expanded",
            "limits",
            "complete"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "version",
        "role",
        "case_sha256",
        "model",
        "notes",
        "issues",
        "horizon",
        "algorithm",
        "map_report_sha256",
        "status",
        "paths",
        "metrics",
        "reason",
        "search"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "version": {
          "const": "1.0.0"
        },
        "role": {
          "const": "verifier"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "const": "grid-4-wait-stay-v1"
        },
        "notes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verdict": {
          "enum": [
            "route_valid",
            "route_invalid",
            "no_route_to_verify"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "tick": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 40
              },
              "robots": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string"
                }
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "tick",
              "robots",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "metrics": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "sum_of_costs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 160
                },
                "makespan": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 40
                }
              },
              "required": [
                "sum_of_costs",
                "makespan"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "version",
        "role",
        "case_sha256",
        "model",
        "notes",
        "issues",
        "plan_sha256",
        "model_report_sha256",
        "verdict",
        "findings",
        "metrics"
      ],
      "additionalProperties": false
    }
  }
}
